library(doParallel)
library(foreach)


perform_n <- function(
    ndev,
    n.para,
    beta0,
    beta,
    fixed_patients,
    n.loop = 100
) {

  predictor_names <- paste0(
    "X",
    seq_len(n.para)
  )

  # Models receive predictors only
  fixed_x <- fixed_patients[, predictor_names, drop = FALSE]

  fixed_y <- fixed_patients$y
  fixed_p_true <- fixed_patients$p_true

  patient_id <- seq_len(
    nrow(fixed_patients)
  )

   # Register parallel backend with the number of cores available
  n.cores <- parallel::detectCores() - 2  # use one less than total cores to avoid overloading
  cl <- makeCluster(n.cores)
  registerDoParallel(cl)

  prev <- 0.3
  auc <- 0.8
  n.loop <- 100 # first try 5 loops to check the code, then 100
  results <- foreach(i = 1: n.loop, .combine = rbind, .packages = c("glmnet", "pROC", "stats", "tidyverse", "rstanarm", "projpred", "loo", "pander"),
                     .export = c("generate_ss", "back_logit", "backward_pvalue", "mod_penal_ave_foreach")) %dopar%{

    set.seed(i)

    data.dev <- generate_ss(
      ndev,
      n.para,
      beta0,
      beta
    )
    x <- data.dev[,-1]
    y <- data.dev[,1]

    # ========================================================
    # Initialise six-patient probability results
    # ========================================================

    patient_result <- expand.grid(
      simulation = i,
      method = c(
        "MLE",
        "BE-5%",
        "LS-min",
        "LS-mod"
      ),
      patient_id = patient_id,
      KEEP.OUT.ATTRS = FALSE,
      stringsAsFactors = FALSE
    )

    patient_result$observed_y <- fixed_y[
      patient_result$patient_id
    ]

    patient_result$p_true <- fixed_p_true[
      patient_result$patient_id
    ]

    patient_result$p_estimated <- NA_real_


    # ========================================================
    # Method 1: full maximum-likelihood model
    # ========================================================

    tryCatch({

      fit <- glm(
        y ~ .,
        data = data.dev,
        family = binomial()
      )

      # Six fixed-patient predictions
      p_patient_mle <- as.numeric(
        predict(
          fit,
          newdata = fixed_x,
          type = "response"
        )
      )

      patient_result$p_estimated[
        patient_result$method == "MLE"
      ] <- p_patient_mle

    }, error = function(e) {

      message(
        "Simulation ",
        i,
        ": error in MLE: ",
        conditionMessage(e)
      )
    })


    # ========================================================
    # Method 2: backward elimination, p < 0.05
    # ========================================================

    tryCatch({

      p_threshold <- 0.05

      back_05 <- back_logit(
        data.dev,
        "y",
        "p_value",
        p_threshold
      )

      varsel_back_05 <- back_05$varsel_back
      backmodel_05 <- back_05$backmodel

      selected_names <- predictor_names[
        varsel_back_05 == 1
      ]

      # Six fixed-patient predictions
      p_patient_be <- as.numeric(
        predict(
          backmodel_05,
          newdata = fixed_x,
          type = "response"
        )
      )

      patient_result$p_estimated[
        patient_result$method == "BE-5%"
      ] <- p_patient_be

    }, error = function(e) {

      message(
        "Simulation ",
        i,
        ": error in backward elimination: ",
        conditionMessage(e)
      )
    })


    # ========================================================
    # Method 3: standard LASSO using lambda.min
    # ========================================================

    tryCatch({

      lasso <- glmnet::cv.glmnet(
        x = as.matrix(x),
        y = y,
        alpha = 1,
        family = "binomial",
        type.measure = "deviance"
      )

      lambda_min <- lasso$lambda.min
     
      # Six fixed-patient predictions
      p_patient_lasso <- as.numeric(
        predict(
          lasso,
          newx = as.matrix(fixed_x),
          s = lambda_min,
          type = "response"
        )
      )

      patient_result$p_estimated[
        patient_result$method == "LS-min"
      ] <- p_patient_lasso

    }, error = function(e) {

      message(
        "Simulation ",
        i,
        ": error in LASSO: ",
        conditionMessage(e)
      )
    })


    # ========================================================
    # Method 4: modified LASSO
    # ========================================================

    tryCatch({
      nfolds <- 10
      f <- nfolds / (nfolds - 1) - 1
      mod_lasso <- mod_penal_ave_foreach(x = as.matrix(x), y = y, bn = 20, method = "lasso", f = f,
                  parallel = FALSE, nfolds = nfolds, boot = TRUE)
      eta_mod_lasso <- as.matrix(cbind(1,fixed_x))%*% mod_lasso$beta.boot
      p_mod_lasso <- as.vector(1/(1+exp(-eta_mod_lasso)))

      patient_result$p_estimated[
        patient_result$method == "LS-mod"
      ] <- p_mod_lasso

    }, error = function(e) {

      message(
        "Simulation ",
        i,
        ": error in modified LASSO: ",
        conditionMessage(e)
      )
    })


    method_result$simulation <- i

    list(
      patient_predictions = patient_result
    )
  }

  patient_predictions <- do.call(
    rbind,
    lapply(
      simulation_results,
      function(z) z$patient_predictions
    )
  )

  rownames(patient_predictions) <- NULL


  # Ensure numerical patient columns
  patient_predictions$simulation <- as.integer(
    patient_predictions$simulation
  )

  patient_predictions$patient_id <- as.integer(
    patient_predictions$patient_id
  )

  patient_predictions$observed_y <- as.numeric(
    patient_predictions$observed_y
  )

  patient_predictions$p_true <- as.numeric(
    patient_predictions$p_true
  )

  patient_predictions$p_estimated <- as.numeric(
    patient_predictions$p_estimated
  )


  # ==========================================================
  # Return both outputs
  # ==========================================================

  list(
    performance = performance_results,
    patient_predictions = patient_predictions
  )
}


