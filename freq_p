# A cleaner summary with separate columns
patient_probability_summary <- do.call(
  rbind,
  lapply(
    split(
      patient_probs_n,
      list(
        patient_probs_n$method,
        patient_probs_n$patient_id
      ),
      drop = TRUE
    ),
    function(d) {

      valid_predictions <- d$p_estimated[
        !is.na(d$p_estimated)
      ]

      data.frame(
        method = d$method[1],
        patient_id = d$patient_id[1],
        observed_y = d$observed_y[1],
        p_true = d$p_true[1],
        mean_probability = mean(
          valid_predictions
        ),
        sd_probability = sd(
          valid_predictions
        ),
        bias = mean(
          valid_predictions
        ) - d$p_true[1],
        mse = mean(
          (
            valid_predictions -
              d$p_true[1]
          )^2
        ),
        successful_simulations = length(
          valid_predictions
        )
      )
    }
  )
)

rownames(patient_probability_summary) <- NULL
